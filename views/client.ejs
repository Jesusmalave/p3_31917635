                        <div class="p-3" style="max-width: 900px;">
                            <i></i>
                            <h1 class="display-2 text-uppercase text-white mb-md-4">Descubre el placer, de nuestras frescas verduras.</h1>
                            <a href="#contact" class="btn btn-primary py-md-3 px-md-5 mt-2">Contactanos </a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <img class="w-100" src="/img/carousel-2.jpg" alt="Image">
                    <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                        <div class="p-3" style="max-width: 900px;">
                            <i></i>
                            <h1 class="display-2 text-uppercase text-white mb-md-4">Las mejores verduras del mercado.</h1>
